# -----------------------------------------------------------------------------
# Retriva local containerized deployment
# Copy this file to .env and edit it.
# -----------------------------------------------------------------------------

# --- Project Configuration ---
# Change this to tag your build/deployment (e.g. customer-a, customer-b)
COMPOSE_PROJECT_NAME=retriva-local

# --- Repository paths, relative to this deployment folder ---
RETRIVA_CORE_DIR=../retriva-core
RETRIVA_GATEWAY_DIR=../retriva-gateway
RETRIVA_WEBUI_DIR=../retriva-webui
RETRIVA_MEDIAWIKI_CONNECTOR_DIR=../retriva-mediawiki-connector
RETRIVA_EMAIL_AGENT_CONNECTOR_DIR=../retriva-email-agent-connector
RETRIVA_MESSAGING_DIR=../retriva-messaging-extension
RETRIVA_WEB_RESEARCH_DIR=../retriva-web-research
RETRIVA_CRM_ASSISTANT_DIR=../retriva-crm-assistant
# Core build: use workspace parent (..) as context so the Pro build stage
# can COPY the extension repos, and target the "pro" stage to install them.
# Leave commented for the Core-only build (target: base — no Pro package
# installed; this is the genuine Core-only deployment image).  The shared
# PostgreSQL platform one-shots always use the `base` stage
# (RETRIVA_PG_BUILD_TARGET), and the CRM extension one-shots always use
# the `pro` stage (RETRIVA_PG_CRM_BUILD_TARGET).
#RETRIVA_CORE_CONTEXT=..
#RETRIVA_CORE_BUILD_TARGET=pro
#RETRIVA_PG_CRM_BUILD_TARGET=pro
# Gateway build: same pattern as Core. Use workspace parent (..) as context
# and target the "pro" stage to install the IAM Entra extension.
# Leave commented to use the standard OSS Gateway build (target: base).
#RETRIVA_GATEWAY_CONTEXT=..
#RETRIVA_GATEWAY_BUILD_TARGET=pro
# RETRIVA_GATEWAY_DOCKERFILE at Dockerfile.gateway-pro.
#RETRIVA_GATEWAY_CONTEXT=../retriva-gateway

# --- Images ---
QDRANT_IMAGE=qdrant/qdrant:latest
TIKA_IMAGE=apache/tika:latest-full
RETRIVA_CORE_IMAGE=retriva-core:local
RETRIVA_GATEWAY_IMAGE=retriva-gateway:local
RETRIVA_WEBUI_IMAGE=retriva-webui:local
RETRIVA_MEDIAWIKI_CONNECTOR_IMAGE=retriva-mediawiki-connector:local
RETRIVA_EMAIL_AGENT_CONNECTOR_IMAGE=retriva-email-agent-connector:local
RETRIVA_MESSAGING_IMAGE=retriva-messaging:local
APPRISE_API_IMAGE=caronc/apprise:latest
WHISPER_IMAGE=ghcr.io/ggerganov/whisper.cpp:main

# --- Host ports ---
QDRANT_HTTP_PORT=6333
QDRANT_GRPC_PORT=6334
TIKA_BIND_ADDR=127.0.0.1
TIKA_PORT=9998
INGESTION_PORT=8000
CORE_PORT=8001
GATEWAY_PORT=8002
WEBUI_PORT=5173
WHISPER_PORT=8100
MESSAGING_PORT=8005

# --- LLM / embedding / vision provider (OpenAI-compatible) -------------------
# Retriva uses ONE API key, fanned out internally to every purpose
# (embeddings, vision, chat, rerank).
OPENAI_PROVIDER_API_KEY=replace-me

# Single knob to redirect ALL traffic to a different OpenAI-compatible
# provider (e.g. a local vLLM/Ollama server). Must include the /v1 suffix.
# Defaults to OpenRouter. The per-purpose *_BASE_URL vars below inherit this
# value unless explicitly overridden.
LLM_PROVIDER_BASE_URL=https://openrouter.ai/api/v1

# Optional PER-PURPOSE base-URL overrides. Leave commented to inherit
# LLM_PROVIDER_BASE_URL above. Use these to split traffic across providers,
# e.g. local embeddings but hosted chat/vision.
#EMBEDDING_BASE_URL=https://openrouter.ai/api/v1
#VISUAL_BASE_URL=https://openrouter.ai/api/v1
#CHAT_BASE_URL=https://openrouter.ai/api/v1
#RETRIEVAL_RERANK_BASE_URL=https://openrouter.ai/api/v1

# Optional PER-PURPOSE API-key overrides. Leave commented to inherit
# OPENAI_PROVIDER_API_KEY above. Set these when a *_BASE_URL above points to
# a provider that requires a different key (e.g. OpenAI for chat, OpenRouter
# for embeddings). The rerank key is used for the Cohere-compatible /rerank
# endpoint.
#EMBEDDING_API_KEY=
#VISUAL_API_KEY=
#CHAT_API_KEY=
#RETRIEVAL_RERANK_API_KEY=


# Models per purpose.
CHAT_MODEL=qwen/qwen3.5-27b
EMBEDDING_MODEL=baai/bge-m3
VISUAL_MODEL=qwen/qwen3-vl-32b-instruct

# --- Reranking provider (global) ---------------------------------------------
# One reranking provider + model serve every knowledge base, retrieval
# operation, user, and customer. There is no per-KB reranker configuration.
#
# RETRIEVAL_RERANK_PROVIDER selects the transport. 'bedrock' is the CANONICAL
# Bedrock value; the aliases 'aws_bedrock' and 'aws-bedrock' (case- and
# whitespace-insensitive) are accepted and normalize to 'bedrock' in all
# logs, metrics, status output and cache identities.
#   "" / "openrouter" (default)  Cohere-compatible POST /rerank via
#                                RETRIEVAL_RERANK_BASE_URL + API key below.
#                                Keeps legacy behavior for existing
#                                deployments. ('cohere' is an alias.)
#   "bedrock"                    Amazon Bedrock Rerank via the dedicated
#                                bedrock-agent-runtime Rerank API. Requires
#                                boto3 >= 1.35.72. RETRIEVAL_RERANK_MODEL
#                                accepts a bare rerank model id (e.g.
#                                amazon.rerank-v1:0 or cohere.rerank-v3-5:0)
#                                or a full model ARN. Credentials come from
#                                the standard AWS chain (AWS_ACCESS_KEY_ID /
#                                AWS_SECRET_ACCESS_KEY / AWS_SESSION_TOKEN
#                                env vars, shared config files, or the
#                                workload IAM role) — never Retriva settings.
#                                RETRIEVAL_RERANK_API_KEY is ignored in
#                                bedrock mode. Marketplace models (e.g.
#                                Cohere Rerank 3.5) require a one-time model
#                                subscription for the account in that
#                                region. Model/provider changes require a
#                                process restart.
#RETRIEVAL_RERANK_PROVIDER=
# Region for Bedrock (falls back to AWS_REGION / AWS_DEFAULT_REGION).
#RETRIEVAL_RERANK_AWS_REGION=eu-central-1
#
# Strict startup validation: when true, Retriva APIs FAIL to start on
# invalid rerank configuration (unsupported provider, missing region/model,
# unsupported SDK operation, invalid endpoint, invalid numeric settings, EU
# policy violations). Default false keeps the legacy log-and-continue
# behavior (invalid numeric settings are defaulted with a sanitized warning
# and a degraded status on /internal/reranker/status).
#RETRIEVAL_RERANK_STRICT_STARTUP_VALIDATION=false
#
# EU data-residency enforcement (bedrock provider, opt-in): reject regions
# outside RETRIEVAL_RERANK_ALLOWED_AWS_REGIONS, model-ARN/region mismatches
# and endpoint overrides. No rerouting, no provider fallback.
#RETRIEVAL_RERANK_ENFORCE_EU_REGION=false
#RETRIEVAL_RERANK_ALLOWED_AWS_REGIONS=eu-central-1

# Optional transport tuning (applies to every provider; defaults shown).
#RETRIEVAL_RERANK_TIMEOUT=30.0
#RETRIEVAL_RERANK_MAX_RETRIES=2
#RETRIEVAL_RERANK_RETRY_BASE_DELAY=1.0

# Reasoning effort for chat models that support it (e.g. OpenAI o-series,
# DeepSeek-R1).  Values: low, medium, high.  Leave commented to use the
# model default (no reasoning_effort parameter sent).
#CHAT_REASONING_EFFORT=high

# --- System prompt override (Retriva Pro / per-customer customisation) ---
# When set, this string REPLACES the default Retriva grounded-QA system prompt
# defined in retriva-core/src/retriva/qa/prompting.py.  This is the primary
# no-code hook used by Retriva Pro deployments and per-customer branding /
# behaviour tweaks.
#
# The override may reference two placeholders that Retriva substitutes at
# runtime:
#   {source_list}  - the numbered list of cited sources ([1] label, [2] ...)
#   {context}      - the concatenated <source>…</source> context blocks
# If neither placeholder is present in the override, the source list and
# context are appended automatically so the model still sees the evidence.
# Leave commented to use the built-in default prompt.
#SYSTEM_PROMPT_OVERRIDE=

# --- Core/Gateway wiring ---
# Inter-container URLs are derived from docker-compose.yml defaults.
# Override here only if you need non-standard values.
RETRIVA_DEFAULT_COLLECTION=retriva_chunks
#QDRANT_URL=http://qdrant:6333
#TIKA_SERVER_URL=http://tika:9998
#RETRIVA_CORE_INGESTION_URL=http://retriva-ingestion:8000
#RETRIVA_CORE_CHAT_URL=http://retriva-core:8001
#GATEWAY_BASE_URL=http://retriva-gateway:8002
#RETRIVA_GATEWAY_BASE_URL=http://retriva-gateway:8002
# VITE_RETRIVA_GATEWAY_BASE_URL is derived from GATEWAY_PORT in docker-compose.yml.
#VITE_RETRIVA_GATEWAY_BASE_URL=http://localhost:8002

# --- Dynamic ingestion / connectors ---
# Retriva Pro = Retriva Core (Apache 2.0) + commercial extension containers.
# Pro extensions are tagged with the "pro" Docker Compose profile and are only
# started by: ./scripts/manage.sh up-pro  (or the alias up-with-connectors).
# Each new extension should add its own *_DIR and settings block below.
DYNAMIC_INGESTION_ENABLED=true
GATEWAY_INTERNAL_SERVICE_TOKEN=local-dev-service-token-change-me

# --- Retriva Pro: MediaWiki Connector ---
# Licensed separately from Retriva Core. Not covered by the Apache 2.0 license
# of the core components. See retriva-mediawiki-connector/LICENSE.retriva-pro.
# The MEDIAWIKI_CONNECTOR_* vars override config/mediawiki.yaml values.
# USERNAME and BOT_PASSWORD are mapped to MEDIAWIKI_USERNAME/MEDIAWIKI_BOT_PASSWORD
# inside the container (what the connector's mediawiki_client.py expects).
# Enable this connector on startup (on/off, default: off).
MEDIAWIKI_CONNECTOR_ENABLED=off
MEDIAWIKI_CONNECTOR_API_URL=https://your.mediawiki.example/api.php
# Public-facing URL for source links in citations (browser-accessible).
# Set this to the URL users use to browse the wiki from their browser.
# Public-facing URL for source links in citations (browser-accessible).
# Derived from INGESTION_PORT in docker-compose.yml; override here if needed.
#MEDIAWIKI_CONNECTOR_PUBLIC_URL=http://localhost:8000/api.php
MEDIAWIKI_CONNECTOR_PUBLIC_URL=https://your.mediawiki.example/api.php
# Tag to distinguish chunks from this wiki in the knowledge base.
MEDIAWIKI_CONNECTOR_TAG=wiki-1
MEDIAWIKI_CONNECTOR_AUTH_MODE=none
MEDIAWIKI_CONNECTOR_USERNAME=
MEDIAWIKI_CONNECTOR_BOT_PASSWORD=
MEDIAWIKI_CONNECTOR_SOURCE_ID=src_local_mediawiki
MEDIAWIKI_CONNECTOR_TARGET_KB_ID=default
MEDIAWIKI_CONNECTOR_COLLECTION=
MEDIAWIKI_CONNECTOR_KB_IDS=
MEDIAWIKI_CONNECTOR_COMMAND=daemon

# --- Local-development MediaWiki dependency (mediawiki-local) ---
# A private, persistent MediaWiki used only for local-development connector
# validation.  It is reachable only as `mediawiki-local` on the
# `retriva-local-net` network and is not published on any host port.  It backs
# the default MEDIAWIKI_CONNECTOR_API_URL above when that is pointed at the
# local wiki.  Its database is isolated from the Retriva centralized
# PostgreSQL store.  All passwords below are synthetic local-development
# values; leave them blank here and set real generated values in your
# gitignored `.env` (never commit credentials).
MEDIAWIKI_LOCAL_IMAGE=mediawiki:1.43.11
MEDIAWIKI_LOCAL_DB_IMAGE=mariadb:11.4
MEDIAWIKI_LOCAL_DB_NAME=mediawiki_local
MEDIAWIKI_LOCAL_DB_USER=mediawiki
MEDIAWIKI_LOCAL_DB_PASSWORD=
MEDIAWIKI_LOCAL_DB_ROOT_PASSWORD=
MEDIAWIKI_LOCAL_ADMIN_USER=retriva_admin
MEDIAWIKI_LOCAL_ADMIN_PASSWORD=
MEDIAWIKI_LOCAL_SERVER=http://mediawiki-local
MEDIAWIKI_LOCAL_SITE_NAME=Retriva Local Wiki

# --- Retriva Pro: MediaWiki Connector #2 (optional) ---
# Uncomment and customize to sync a second MediaWiki instance.
# Enable this connector on startup (on/off, default: off).
# MEDIAWIKI_CONNECTOR_2_ENABLED=off
# MEDIAWIKI_CONNECTOR_2_API_URL=https://second.wiki.example/api.php
# MEDIAWIKI_CONNECTOR_2_PUBLIC_URL=https://second.wiki.example/api.php
# MEDIAWIKI_CONNECTOR_2_TAG=wiki-2
# MEDIAWIKI_CONNECTOR_2_AUTH_MODE=none
# MEDIAWIKI_CONNECTOR_2_USERNAME=
# MEDIAWIKI_CONNECTOR_2_BOT_PASSWORD=
# MEDIAWIKI_CONNECTOR_2_SOURCE_ID=src_mediawiki_2
# MEDIAWIKI_CONNECTOR_2_TARGET_KB_ID=default
# MEDIAWIKI_CONNECTOR_2_COMMAND=daemon

# --- Retriva Pro: Email Agent Connector ---
# Enable this connector on startup (on/off, default: off).
EMAIL_AGENT_CONNECTOR_ENABLED=off
EMAIL_AGENT_CONNECTOR_TENANT_ID=local-dev
EMAIL_AGENT_CONNECTOR_SOURCE_ID=src_local_email_agent
EMAIL_AGENT_CONNECTOR_TARGET_KB_ID=default
EMAIL_AGENT_CONNECTOR_COLLECTION=
EMAIL_AGENT_CONNECTOR_KB_IDS=
EMAIL_AGENT_CONNECTOR_SMTP_HOST=0.0.0.0
EMAIL_AGENT_CONNECTOR_SMTP_PORT=8025
EMAIL_AGENT_CONNECTOR_SMTP_REQUIRE_TLS=false
EMAIL_AGENT_CONNECTOR_WAIT_FOR_JOB=true
EMAIL_AGENT_CONNECTOR_JOB_POLL_INTERVAL_SECONDS=2
EMAIL_AGENT_CONNECTOR_JOB_TIMEOUT_SECONDS=120
EMAIL_AGENT_CONNECTOR_ADDRESS_PREFIX=retriva
EMAIL_AGENT_CONNECTOR_ADDRESS_DOMAIN=
EMAIL_AGENT_CONNECTOR_COMMAND=run
EMAIL_AGENT_SMTP_HOST_PORT=127.0.0.1:8025

# --- Retriva Pro: Messaging Extension ---
# Durable, asynchronous, multi-channel notifications.
# Licensed separately from Retriva Core. Not covered by the Apache 2.0
# license of the core components. See
# ../retriva-messaging-extension/LICENSE.retriva-pro.
#
# Three services are started under the "pro" profile:
#   retriva-messaging-db  — PostgreSQL (dedicated database)
#   apprise-api           — Apprise API server (delivery adapter)
#   retriva-messaging     — Messaging API + worker
#
# Enable this extension on startup (on/off, default: off).
RETRIVA_MESSAGING_ENABLED=off
# Operating mode: "global" (deployment-level aliases) or "per_user"
# (requires authenticated user identity).
RETRIVA_MESSAGING_MODE=global
# Channels (comma-separated or JSON array). Only "email" is implemented.
RETRIVA_MESSAGING_ENABLED_CHANNELS=email
RETRIVA_MESSAGING_DEFAULT_CHANNELS=email
# Reject untrusted destination addresses when false (recommended).
RETRIVA_MESSAGING_ALLOW_ARBITRARY_DESTINATIONS=false
# --- Messaging database (shared Retriva PostgreSQL; Spec 024) ---
# Messaging uses the SAME PostgreSQL instance and `retriva` database as
# Core and CRM, in the Pro-owned `messaging` schema.  The retired
# dedicated service (retriva-messaging-db / MESSAGING_DB_* vars /
# `retriva_messaging` database) is removed.
RETRIVA_MESSAGING_DB_USER=retriva_messaging
RETRIVA_MESSAGING_DB_PASSWORD=
#RETRIVA_MESSAGING_DB_PASSWORD_FILE=/run/secrets/messaging_db_password
# --- Apprise backend adapter ---
RETRIVA_MESSAGING_APPRISE_API_URL=http://apprise-api:8000
RETRIVA_MESSAGING_APPRISE_EMAIL_TAG=retriva-email
# --- Email channel defaults (global mode) ---
RETRIVA_MESSAGING_EMAIL_FROM_ADDRESS=retriva@localhost
RETRIVA_MESSAGING_EMAIL_FROM_NAME=Retriva
# --- Security ---
# When set, internal API endpoints require X-Service-Token header.
RETRIVA_MESSAGING_INTERNAL_SERVICE_TOKEN=
# Encryption key for destination addresses at rest. If unset, a no-op vault
# is used (addresses stored unencrypted — local dev only).
#RETRIVA_MESSAGING_DESTINATION_VAULT_KEY=change-me-to-a-long-random-string
# --- Per-user mode ---
# Requires upstream authenticated-user identity contract.
RETRIVA_MESSAGING_PER_USER_IDENTITY_AVAILABLE=false
# --- Logging ---
MESSAGING_LOG_LEVEL=INFO

# --- Logging / debugging ---
ENABLE_INTERNAL_PROFILER=true
CORE_LOG_LEVEL=INFO
GATEWAY_LOG_LEVEL=INFO
QDRANT_TELEMETRY_DISABLED=true

# --- Authentication (Microsoft Entra ID) ---
# Auth is disabled by default. To enable Entra ID authentication:
#   1. Register an application in Microsoft Entra ID (see README in
#      retriva-iam-entra for step-by-step instructions).
#   2. Use the Pro Gateway build path below.
#   3. Set RETRIVA_AUTH_PROVIDER=entra and fill in the RETRIVA_ENTRA_* vars.
#   4. Set VITE_RETRIVA_AUTH_PROVIDER=entra and the VITE_RETRIVA_ENTRA_* vars
#      (these are build-time args for the WebUI).
#
# When RETRIVA_AUTH_PROVIDER=none (default), all Entra variables below are
# ignored and the Gateway accepts anonymous requests.

# Build a Gateway image that installs the Retriva Pro Entra provider.
# These values assume this deployment repo is next to retriva-gateway and
# retriva-iam-entra:
#   workspace/
#   ├── retriva-local-containerized-deployment/
#   ├── retriva-gateway/
#   └── retriva-iam-entra/
RETRIVA_GATEWAY_CONTEXT=..
RETRIVA_GATEWAY_DOCKERFILE=retriva-local-containerized-deployment/Dockerfile.gateway-pro

# Activate the Entra ID auth provider.
RETRIVA_AUTH_PROVIDER=none

# Paths that bypass authentication (JSON array, prefix match).
RETRIVA_AUTH_EXEMPT_PATHS=/health,/ready,/capabilities

# --- Required when RETRIVA_AUTH_PROVIDER=entra ---
# Azure AD tenant ID (GUID).
RETRIVA_ENTRA_TENANT_ID=

# Expected `aud` claim in access tokens.
# For a single-page app + API, this is typically `api://<gateway-client-id>`.
RETRIVA_ENTRA_AUDIENCE=

# --- Optional ---
# Expected `iss` claim. Defaults to:
#   https://login.microsoftonline.com/<TENANT_ID>/v2.0
#RETRIVA_ENTRA_ISSUER=

# Comma-separated or JSON-array scopes the access token must contain (empty = no check).
# Example: Retriva.Access
#RETRIVA_ENTRA_REQUIRED_SCOPES=Retriva.Access

# JWT claim that carries app roles (default: roles).
#RETRIVA_ENTRA_ROLE_CLAIM=roles

# JWT claim that carries group memberships (default: groups).
#RETRIVA_ENTRA_GROUPS_CLAIM=groups

# How often (in seconds) to re-fetch the JWKS key set (default: 3600).
#RETRIVA_ENTRA_JWKS_REFRESH_SECONDS=3600

# === WebUI (frontend, build-time via VITE_*) ===
# These must be available at `npm run build` time — they are embedded into
# the static assets.  In Docker, pass them as build args (already wired in
# docker-compose.yml).

# Must match RETRIVA_AUTH_PROVIDER on the Gateway.
VITE_RETRIVA_AUTH_PROVIDER=none

# Entra app registration client ID for the SPA (public, not secret).
VITE_RETRIVA_ENTRA_CLIENT_ID=

# Entra tenant ID (same as RETRIVA_ENTRA_TENANT_ID).
VITE_RETRIVA_ENTRA_TENANT_ID=

# Authority URL. Defaults to:
#   https://login.microsoftonline.com/<TENANT_ID>
# Set this to use a custom authority (e.g. B2C).
#VITE_RETRIVA_ENTRA_AUTHORITY=

# Comma-separated scopes requested by the SPA during token acquisition.
# Should include the scope exposed by the Gateway's app registration.
# Example: api://<gateway-client-id>/Retriva.Access
VITE_RETRIVA_ENTRA_SCOPES=

# --- Speech-to-Text (Whisper) ---
STT_ENABLED=true
WHISPER_SERVER_URL=http://whisper:${WHISPER_PORT}/inference
WHISPER_MODEL=ggml-base.en.bin
VITE_SPEECH_INPUT_MODE=gateway
VITE_RETRIVA_ENABLE_VOICE_INPUT=true

# Extra attempts on 429 / connection / timeout / 5xx errors (0 = no retries).
VISUAL_MAX_RETRIES=5
# Initial backoff in seconds; doubled each retry (with jitter), capped below.
VISUAL_RETRY_BASE_DELAY=2.0
# Ceiling for a single backoff sleep, in seconds.
VISUAL_RETRY_MAX_DELAY=60.0
# Seconds to sleep between successive image descriptions (0 = no pacing).
# Raise this (e.g. 1.5) if you keep hitting upstream rate limits.
VISUAL_INTER_CALL_DELAY=1.5

# --- Async Job Queue (Celery + Redis) ---
# When set, v2 ingestion tasks are dispatched to a Celery worker instead of
# running as FastAPI BackgroundTasks. This makes long-running ingestions
# (e.g. OCRmyPDF on large scanned PDFs) survive API container restarts.
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
# Number of concurrent worker processes (each can use significant CPU/RAM).
CELERY_WORKER_CONCURRENCY=1
# Max retries for failed tasks.
CELERY_TASK_MAX_RETRIES=3
# Soft/hard time limits in seconds (0 = no limit).
CELERY_TASK_SOFT_TIME_LIMIT=0
CELERY_TASK_TIME_LIMIT=0

# --- Redis ACL hardening (Spec 034 / ADR-039) -------------------------------
# Required by docker-compose for the hardened Redis service. Generate each
# value with a CSPRNG; allowed alphabet A-Z a-z 0-9 _ - ; keep them OUT of
# Git (this file documents names only) and rotate per docs/redis-acl-runbook.md.
REDIS_BROKER_PASSWORD=
REDIS_RESULTS_PASSWORD=
REDIS_MONITOR_PASSWORD=
REDIS_HEALTH_PASSWORD=
# Staged rollout only: "yes" temporarily keeps the default user available
# while service identities are cut over; the final posture is "no".
REDIS_ALLOW_UNAUTHENTICATED_DEFAULT=no

# --- GraphRAG ---
# When enabled, a GRAPH_INDEXING stage runs after vector indexing to extract
# entities, assertions, and relationships from document chunks. Graph data is
# stored in a SQLite file on the retriva_core_storage volume (no new container).
# Retrieval can use 'vector' (default), 'graph_local', or 'hybrid' modes.
GRAPH_ENABLED=false
GRAPH_STORE_BACKEND=sqlite
GRAPH_TRAVERSAL_MAX_DEPTH=2
GRAPH_TRAVERSAL_MAX_NODES=50
GRAPH_TRAVERSAL_MAX_EDGES=100
GRAPH_CONTEXT_TOKEN_BUDGET=4000
GRAPH_QUERY_TIMEOUT_SECONDS=5.0
GRAPH_MAX_CHUNKS_PER_ENTITY=5
GRAPH_EXTRACTION_CONFIDENCE_THRESHOLD=0.5
GRAPH_DEFAULT_RETRIEVAL_MODE=vector

# --- Retriva Pro Extensions ---
# Comma-separated dotted module paths to load at startup.
# To enable the CRM Assistant, set:
#   RETRIVA_EXTENSIONS=retriva_crm_assistant
RETRIVA_EXTENSIONS=

# --- Session Document Processing ---
SESSION_ATTACHMENT_MAX_SIZE=52428800
SESSION_ATTACHMENT_TTL_SECONDS=86400
SESSION_ARTIFACT_TTL_SECONDS=172800

# --- Task LLM (for extensions: extraction, classification, summarization) ---
# When empty, falls back to the chat LLM settings above.
# Set these to use a different (e.g. smaller/faster/cheaper) model for
# CRM Assistant batch tasks like offering extraction and ICP summarization.
#TASK_BASE_URL=https://openrouter.ai/api/v1
#TASK_MODEL=qwen/qwen3.5-14b
#TASK_API_KEY=
# System prompt for the task LLM (distinct from the chat system prompt).
# When empty, a built-in default is used.
#TASK_SYSTEM_PROMPT=

# --- CRM Assistant ---
# SearXNG is the default production search provider (ADR-014). The internal
# retriva-searxng container performs URL discovery; source pages are still
# retrieved by the controlled HTTP provider. No external API key is required.
CRM_PUBLIC_RESEARCH_PROVIDER=searxng
CRM_SEARXNG_URL=http://retriva-searxng:8080
CRM_SEARXNG_TIMEOUT_SECONDS=20
CRM_SEARXNG_MAX_RESULTS=8
CRM_SEARXNG_LANGUAGE=auto
CRM_SEARXNG_SAFESEARCH=1
CRM_SEARXNG_MAX_CONCURRENT=2
CRM_SEARXNG_MIN_INTERVAL_MS=1000
CRM_SEARXNG_MAX_RETRIES=1
CRM_SEARXNG_READINESS_CACHE_SECONDS=30
CRM_ALLOW_MOCK_FALLBACK=false
CRM_DIRECT_FETCH_TIMEOUT_SECONDS=15
CRM_DIRECT_FETCH_MAX_BYTES=1048576
CRM_LLM_ENRICHMENT_ENABLED=true
# Deprecated alias: CRM_ICP_REFERENCE_TOP_K (still accepted).
CRM_ACP_REFERENCE_TOP_K=20
CRM_MAX_CANDIDATES_PER_RUN=200

# --- Apollo organization enrichment (PAID, 1 credit/call) -------------------
# G5 (verified against Apollo's official OpenAPI spec, 2026-08-31):
#   Base URL   https://api.apollo.io/api/v1
#   Endpoint   GET /organizations/enrich (auth: x-api-key header)
#   Readiness  GET /auth/health (zero credits)
# Leave EMPTY to keep the provider fail-closed/unavailable. Add your real
# key in your LOCAL .env (git-ignored) only after the clean build passes.
CRM_APOLLO_API_KEY=
CRM_APOLLO_BASE_URL=https://api.apollo.io/api/v1
# Apollo enrichment bills 1 apollo_credit per organization.
CRM_COST_APOLLO_PER_ENRICHMENT=1.0
# NEVER enable in production: synthetic Apollo simulation is test-only.
CRM_APOLLO_TEST_SIMULATION_ENABLED=false
# Paid-research mode (G3): PAID_DISABLED | FREE_SOURCES_ONLY |
# PAID_REQUIRES_APPROVAL | PAID_AUTOMATIC_WITHIN_BUDGET |
# SPECIFIC_PROVIDERS_ONLY (then set CRM_PAID_ALLOWED_PROVIDERS=apollo).
CRM_PAID_RESEARCH_MODE=PAID_REQUIRES_APPROVAL
CRM_PAID_ALLOWED_PROVIDERS=
# Atomic credit budgets (G4), canonical unit: apollo_credit.
CRM_APOLLO_CREDIT_BUDGET_CANDIDATE=1.0
CRM_APOLLO_CREDIT_BUDGET_JOB=10.0
CRM_APOLLO_CREDIT_BUDGET_TENANT_DAILY=25.0
CRM_BUDGET_COST_UNIT=apollo_credit
# Trusted service principal for executing APPROVED paid-research
# requests via the executor API.  Empty = the executor is only
# invocable from the worker path.  User headers can never force
# execution.
CRM_EXECUTOR_SERVICE_PRINCIPAL=
# Safe smoke-test identity (G7): a real test org YOU control, supplied
# per-run via env/args. Never hardcode a customer identity.
CRM_SMOKE_TEST_ORG_NAME=
CRM_SMOKE_TEST_ORG_DOMAIN=

# --- SearXNG (internal metasearch) ------------------------------------------
# Secret used by SearXNG for cryptography. Generate a real value at install
# time — do NOT use this placeholder operationally:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SEARXNG_SECRET=
SEARXNG_INSTANCE_NAME=retriva-searxng

# --- PostgreSQL Business Intelligence Database (Retriva Pro, "db" profile) ---
# Canonical relational store for organizations, commercial roles,
# relationships, exclusions, ERP imports and audit.  PostgreSQL does NOT
# replace Qdrant (embeddings/retrieval stay in Qdrant).
#
# Deployment:   ./scripts/manage.sh db-up      (postgres + roles +
#                                               migrations + pgAdmin)
# Teardown:     ./scripts/manage.sh db-down
# Migration:    ./scripts/manage.sh db-migrate / db-status
#
# Never commit real credentials.  Generate local secrets with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Each *_PASSWORD also accepts a *_PASSWORD_FILE pointing at a mounted
# secret file (Docker secret or bind mount) instead of a value.
#
# Image is pinned to a specific supported version (never `latest`).
RETRIVA_PG_IMAGE=postgres:16.15-alpine
RETRIVA_PG_DATABASE=retriva
RETRIVA_PG_ADMIN_USER=retriva_admin
# Cluster administrator password (or file).  Used only by the one-shot
# bootstrap step at deployment; long-running services never use it.
RETRIVA_PG_ADMIN_PASSWORD=
#RETRIVA_PG_ADMIN_PASSWORD_FILE=/run/secrets/pg_admin_password
RETRIVA_PG_SSLMODE=prefer

# --- Shared PostgreSQL platform (Spec 024; ADR-029) --------------------------
# PostgreSQL is MANDATORY for every deployment, including Core-only:
# `up` starts postgres -> platform bootstrap -> Core migrations before
# the core services.  One instance, one `retriva` database, module-owned
# schemas (platform, messaging, business, ...), provider-based
# migration streams (core.platform, pro.crm, ...).
# RETRIVA_PG_MIGRATOR_PASSWORD(_FILE): the platform migrator owns
# schemas and schema changes (development-phase shared migrator).
RETRIVA_PG_MIGRATOR_PASSWORD=
#RETRIVA_PG_MIGRATOR_PASSWORD_FILE=/run/secrets/pg_migrator_password
# RETRIVA_PG_CORE_PASSWORD(_FILE): the Core runtime identity (may read
# the migration ledger; no extension schema access).
RETRIVA_PG_CORE_PASSWORD=
#RETRIVA_PG_CORE_PASSWORD_FILE=/run/secrets/pg_core_password

# --- Durable job lifecycle (Spec 025; ADR-030) -------------------------------
# PostgreSQL is the ONLY authoritative logical job store; Celery/Redis is
# the transport (the local BackgroundTasks fallback serves the same
# lifecycle).  These settings flow to the ingestion API, the worker, and
# the operator CLI helpers via env_file.
# RETRIVA_JOBS_DEFAULT_TENANT is MANDATORY: the fixed, server-configured
# tenant applied server-side (ordinary request input never selects a
# tenant).  It is validated at API startup — the ingestion API refuses to
# start without it.
RETRIVA_JOBS_DEFAULT_TENANT=default
# Optional tuning (defaults shown; see retriva.jobs.config):
#RETRIVA_JOBS_TENANT_RESOLVER=fixed
#RETRIVA_JOBS_TENANT_HEADER_OVERRIDE=0
#RETRIVA_JOBS_TENANT_HEADER_NAME=x-retriva-tenant
#RETRIVA_JOBS_RETENTION_SUCCEEDED_DAYS=30
#RETRIVA_JOBS_RETENTION_FAILED_DAYS=90
#RETRIVA_JOBS_RETENTION_CANCELLED_DAYS=90
#RETRIVA_JOBS_MAX_ATTEMPTS=3
#RETRIVA_JOBS_PROGRESS_THROTTLE_SECONDS=5
#RETRIVA_JOBS_RECONCILE_STALE_THRESHOLD_SECONDS=1800
#RETRIVA_JOBS_RECONCILE_BATCH_SIZE=200
#RETRIVA_JOBS_CLEANUP_BATCH_SIZE=500
#RETRIVA_JOBS_PUBLICATION_TRIES_MAX=5

# --- CRM Assistant extension roles (Pro stack; managed by the CRM
# bootstrap step) -------------------------------------------------------------
# application is the runtime DML role (no DDL); importer writes only
# import staging; readonly is SELECT-only; pgadmin_operator is the
# pgAdmin login role.  The migrator credential above is the platform
# one (the deprecated CRM_PG_MIGRATOR_PASSWORD spelling still works).
CRM_PG_APPLICATION_PASSWORD=
#CRM_PG_APPLICATION_PASSWORD_FILE=/run/secrets/pg_application_password
CRM_PG_IMPORTER_PASSWORD=
#CRM_PG_IMPORTER_PASSWORD_FILE=/run/secrets/pg_importer_password
CRM_PG_READONLY_PASSWORD=
#CRM_PG_READONLY_PASSWORD_FILE=/run/secrets/pg_readonly_password
CRM_PGADMIN_UI_OPERATOR_PASSWORD=
#CRM_PGADMIN_UI_OPERATOR_PASSWORD_FILE=/run/secrets/pgadmin_ui_operator_password

# --- CRM Assistant runtime store -----------------------------------------------
# Disabled by default: flipping CRM_PG_ENABLED=true activates
# /api/v2/crm/pg/readiness and the persistence layer after the Pro
# migration step applied the `pro.crm` stream.
CRM_PG_ENABLED=false
# Connection endpoint: the canonical names are the RETRIVA_PG_* vars
# above (host/port/database/sslmode/pool bounds).  The CRM_PG_* spellings
# below are a DEPRECATED compatibility path (kept so existing local .env
# files do not silently break); set the RETRIVA_PG_* ones instead.
#CRM_PG_HOST=retriva-postgres
#CRM_PG_PORT=5432
#CRM_PG_SSLMODE=prefer
#CRM_PG_POOL_MIN_SIZE=1
#CRM_PG_POOL_MAX_SIZE=8
#CRM_PG_CONNECT_TIMEOUT_SECONDS=10
#CRM_PG_STATEMENT_TIMEOUT_MS=30000
#CRM_PG_IDLE_IN_TX_TIMEOUT_MS=60000

# --- pgAdmin (operator UI; binds to localhost by default) --------------------
RETRIVA_PGADMIN_IMAGE=dpage/pgadmin4:9.18
# Optional: the pgAdmin web-UI login email. Defaults to ops@example.com
# (pgAdmin rejects reserved domains such as .local).
RETRIVA_PGADMIN_UI_EMAIL=ops@example.com
RETRIVA_PGADMIN_UI_PASSWORD=
#RETRIVA_PGADMIN_UI_PASSWORD_FILE=/run/secrets/pgadmin_ui_password
RETRIVA_PGADMIN_BIND_ADDR=127.0.0.1
RETRIVA_PGADMIN_PORT=5050

# --- INTENT CLASSIFICATION (Spec 001 Phase D; provider-agnostic) -----------
# Internal service-to-service intent classifier (Core transport; Gateway
# policy).  Disabled by default (constitution §18).  NO default model:
# when enabled, a concrete deployment-global model is mandatory (never
# derived from CHAT_MODEL/VISUAL_MODEL/embedding/reranker settings).
# Canonical providers: openrouter | bedrock (aliases aws_bedrock /
# aws-bedrock normalize to bedrock).  No cross-provider or cross-model
# fallback exists.  Enable EXACTLY ONE of the two alternatives below.
#
# --- Alternative 1: OpenRouter EU ---
#INTENT_CLASSIFIER_ENABLED=true
#INTENT_CLASSIFIER_PROVIDER=openrouter
#INTENT_CLASSIFIER_MODEL=<approved-openrouter-model>
#INTENT_CLASSIFIER_OPENROUTER_BASE_URL=https://eu.openrouter.ai/api/v1
#INTENT_CLASSIFIER_OPENROUTER_API_KEY=<secret>
#INTENT_CLASSIFIER_OPENROUTER_REQUIRE_PARAMETERS=true
#INTENT_CLASSIFIER_OPENROUTER_ALLOW_FALLBACKS=true
#INTENT_CLASSIFIER_OPENROUTER_DATA_COLLECTION=deny
#INTENT_CLASSIFIER_OPENROUTER_ZDR=true
#INTENT_CLASSIFIER_REQUIRE_EU_RESIDENCY=true
#INTENT_CLASSIFIER_REQUIRE_ZDR=true
#INTENT_CLASSIFIER_TIMEOUT_SECONDS=10
#INTENT_CLASSIFIER_MAX_RETRIES=1
#INTENT_CLASSIFIER_MAX_CONCURRENT_REQUESTS=8
#INTENT_CLASSIFIER_MAX_INPUT_CHARS=2000
#INTENT_CLASSIFIER_MAX_REQUEST_BYTES=32768
#INTENT_CLASSIFIER_RATE_LIMIT_PER_MINUTE=120
#INTENT_CLASSIFIER_PROMPT_VERSION=1
#INTENT_CLASSIFIER_SERVICE_AUTH_TOKEN=<secret>
# Gateway-side policy (must match the token above).
#AGENT_INTENT_CLASSIFIER_ENABLED=true
#AGENT_INTENT_CLASSIFIER_MIN_CONFIDENCE=0.85
#AGENT_INTENT_CLASSIFIER_SAFE_WORKFLOW_MIN_CONFIDENCE=0.90
#AGENT_INTENT_CLASSIFIER_MAX_INPUT_CHARS=2000
#AGENT_INTENT_CLASSIFIER_MAX_CONTEXT_TURNS=4
#AGENT_INTENT_CLASSIFIER_FAIL_MODE=clarify
#AGENT_INTENT_CLASSIFIER_SERVICE_AUTH_TOKEN=<secret>
#
# --- Alternative 2: Bedrock EU (mutually exclusive with the above) ---
#INTENT_CLASSIFIER_ENABLED=true
#INTENT_CLASSIFIER_PROVIDER=bedrock
#INTENT_CLASSIFIER_MODEL=<approved-eu-inference-profile-or-regional-model-id>
#INTENT_CLASSIFIER_AWS_REGION=eu-central-1
#INTENT_CLASSIFIER_BEDROCK_INFERENCE_GEOGRAPHY=eu
#INTENT_CLASSIFIER_REQUIRE_EU_RESIDENCY=true
#INTENT_CLASSIFIER_REQUIRE_ZDR=true
#INTENT_CLASSIFIER_TIMEOUT_SECONDS=10
#INTENT_CLASSIFIER_MAX_RETRIES=1
#INTENT_CLASSIFIER_MAX_CONCURRENT_REQUESTS=8
#INTENT_CLASSIFIER_MAX_INPUT_CHARS=2000
#INTENT_CLASSIFIER_MAX_REQUEST_BYTES=32768
#INTENT_CLASSIFIER_RATE_LIMIT_PER_MINUTE=120
#INTENT_CLASSIFIER_PROMPT_VERSION=1
#INTENT_CLASSIFIER_SERVICE_AUTH_TOKEN=<secret>
# Gateway-side policy (must match the token above).
#AGENT_INTENT_CLASSIFIER_ENABLED=true
#AGENT_INTENT_CLASSIFIER_SERVICE_AUTH_TOKEN=<secret>
#
# Operational prerequisites (deployment-verified; not runtime-provable):
#  - OpenRouter: the account, workspace, and API key are covered by the
#    accepted EU in-region and zero-data-retention policies.
#  - Bedrock: the accepted AWS account/project zero-retention policy is
#    in force (provider-side enforcement blocks incompatible calls).

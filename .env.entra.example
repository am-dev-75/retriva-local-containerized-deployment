# -----------------------------------------------------------------------------
# Retriva — Microsoft Entra ID (Azure AD) Authentication
# -----------------------------------------------------------------------------
# This file documents all environment variables required to enable Entra ID
# authentication in a Retriva deployment.
#
# Usage:
#   1. Register an application in Microsoft Entra ID (see README in
#      retriva-iam-entra for step-by-step instructions).
#   2. Copy the relevant variables into your main .env file (or source this
#      file alongside .env).
#   3. Enable the Pro Gateway build path below.
#   4. Set RETRIVA_AUTH_PROVIDER=entra to activate authentication.
#
# When RETRIVA_AUTH_PROVIDER=none (default), all variables below are ignored
# and the Gateway accepts anonymous requests.
# -----------------------------------------------------------------------------

# === Gateway (backend) ===
# Build a Gateway image that installs the Retriva Pro Entra provider.
# These values assume this deployment repo is next to retriva-gateway and
# retriva-iam-entra:
#   workspace/
#   ├── retriva-local-containerized-deployment/
#   ├── retriva-gateway/
#   └── retriva-iam-entra/
RETRIVA_GATEWAY_CONTEXT=..
RETRIVA_GATEWAY_DOCKERFILE=retriva-local-containerized-deployment/Dockerfile.gateway-pro

# Activate the Entra ID auth provider.
RETRIVA_AUTH_PROVIDER=none

# Paths that bypass authentication (JSON array, prefix match).
RETRIVA_AUTH_EXEMPT_PATHS=/health,/ready,/capabilities

# --- Required when RETRIVA_AUTH_PROVIDER=entra ---
# Azure AD tenant ID (GUID).
RETRIVA_ENTRA_TENANT_ID=

# Expected `aud` claim in access tokens.
# For a single-page app + API, this is typically `api://<gateway-client-id>`.
RETRIVA_ENTRA_AUDIENCE=

# --- Optional ---
# Expected `iss` claim. Defaults to:
#   https://login.microsoftonline.com/<TENANT_ID>/v2.0
#RETRIVA_ENTRA_ISSUER=

# Comma-separated or JSON-array scopes the access token must contain (empty = no check).
# Example: Retriva.Access
#RETRIVA_ENTRA_REQUIRED_SCOPES=Retriva.Access

# JWT claim that carries app roles (default: roles).
#RETRIVA_ENTRA_ROLE_CLAIM=roles

# JWT claim that carries group memberships (default: groups).
#RETRIVA_ENTRA_GROUPS_CLAIM=groups

# How often (in seconds) to re-fetch the JWKS key set (default: 3600).
#RETRIVA_ENTRA_JWKS_REFRESH_SECONDS=3600


# === WebUI (frontend, build-time via VITE_*) ===
# These must be available at `npm run build` time — they are embedded into
# the static assets.  In Docker, pass them as build args (already wired in
# docker-compose.yml).

# Must match RETRIVA_AUTH_PROVIDER on the Gateway.
VITE_RETRIVA_AUTH_PROVIDER=none

# Entra app registration client ID for the SPA (public, not secret).
VITE_RETRIVA_ENTRA_CLIENT_ID=

# Entra tenant ID (same as RETRIVA_ENTRA_TENANT_ID).
VITE_RETRIVA_ENTRA_TENANT_ID=

# Authority URL. Defaults to:
#   https://login.microsoftonline.com/<TENANT_ID>
# Set this to use a custom authority (e.g. B2C).
#VITE_RETRIVA_ENTRA_AUTHORITY=

# Comma-separated scopes requested by the SPA during token acquisition.
# Should include the scope exposed by the Gateway's app registration.
# Example: api://<gateway-client-id>/Retriva.Access
VITE_RETRIVA_ENTRA_SCOPES=
